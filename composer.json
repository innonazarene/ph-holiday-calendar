{
    "name": "innonazarene/ph-holiday-calendar",
    "description": "Laravel package that returns Philippine public holidays (from the Official Gazette) for your calendar.",
    "type": "library",
    "license": "MIT",
    "keywords": ["philippines", "holidays", "calendar", "official-gazette", "laravel"],
    "authors": [
        {
            "name": "Tom Ramos Pedales",
            "email": "dev@innonazarene.dev",
            "homepage": "https://rustompedales-portfolio.vercel.app"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/dom-crawler": "^6.0|^7.0",
        "symfony/css-selector": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhHolidayCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhHolidayCalendar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhHolidayCalendar\\PhHolidayCalendarServiceProvider"
            ],
            "aliases": {
                "PhHolidayCalendar": "PhHolidayCalendar\\Facades\\PhHolidayCalendar"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
